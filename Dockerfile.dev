FROM ruby:3.4-slim
RUN apt-get update -qq && apt-get install -y -qq build-essential git libyaml-dev libsqlite3-dev libpq-dev libvips curl pkg-config nodejs chromium chromium-driver >/dev/null \
 && rm -rf /var/lib/apt/lists/*
RUN gem install rails -v "~> 8.1" --no-document
WORKDIR /app
RUN mkdir -p /usr/local/bundle && chmod -R a+rwX /usr/local/bundle
