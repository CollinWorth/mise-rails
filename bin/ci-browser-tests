#!/usr/bin/env bash
# Runs the browser tests the way CI does: once, and then any test that failed gets one more try on its own.
#
# Browser tests drive a real browser against timers and animations, so now and then one loses a race that has nothing to do with
# a bug, and a red build holds back the deploy. A test that fails twice in a row is a real failure and still fails the build.
# Anything that only passed on the retry is reported as a warning so flakiness stays visible and gets fixed.
#
# With arguments (a test file, or file:line) it runs just those instead of the whole browser suite.
set -uo pipefail

log=$(mktemp)
if [ $# -gt 0 ]; then
  bin/rails test "$@" 2>&1 | tee "$log"
else
  bin/rails test:system 2>&1 | tee "$log"
fi
status=${PIPESTATUS[0]}
[ "$status" -eq 0 ] && exit 0

# Rails prints "bin/rails test path:line" under each failure; those are the tests to try again.
failed=$(grep -oE '^bin/rails test test/[^ ]+:[0-9]+' "$log" | sed 's/^bin\/rails test //' | sort -u)
if [ -z "$failed" ]; then
  echo "The browser tests failed, but no single test was named to retry (a crash or load error), so this is a real failure."
  exit "$status"
fi

echo
echo "::warning title=Flaky browser test::Retrying once: $(echo "$failed" | tr '\n' ' ')"
# shellcheck disable=SC2086
if bin/rails test $failed; then
  echo "::warning title=Flaky browser test::These passed on the retry, so they are timing-sensitive and worth fixing: $(echo "$failed" | tr '\n' ' ')"
  exit 0
fi

echo "These failed twice in a row, so they are real failures: $(echo "$failed" | tr '\n' ' ')"
exit 1
